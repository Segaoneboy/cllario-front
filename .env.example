# Базовый URL API Cllario (используется прокси-роутом Next)
BACKEND_URL=http://localhost:5000

# Ключ, который прокси отправляет в заголовке x-admin-registration-key
# при регистрации компании (пока используется только фронтендом)
CLLARIO_ADMIN_REGISTRATION_KEY=

# Счётчик Яндекс.Метрики (можно оставить пустым)
NEXT_PUBLIC_YANDEX_METRIKA=
